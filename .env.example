# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Clerk authentication — create a development instance at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# PostgreSQL — use a pooled URL at runtime and a direct URL for migrations.
# Neon calls its direct URL DATABASE_URL_UNPOOLED.
DATABASE_URL=postgresql://user:password@localhost:5432/alphapilot?schema=public
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/alphapilot?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/alphapilot?schema=public

# Optional: enables OpenAI-powered educational portfolio chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# SnapTrade — commercial API credentials. Never prefix these with NEXT_PUBLIC_.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_ENVIRONMENT=sandbox
# Deprecated by SnapTrade for signature verification; retain only if your account requires it.
SNAPTRADE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROVIDER_SECRETS_ENCRYPTION_KEY=
# Secret used by the scheduled sync worker; set a long random value in Vercel.
CRON_SECRET=
